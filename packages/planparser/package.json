{
  "name": "@sun-yryr/queot-planparser",
  "private": true,
  "version": "0.1.0",
  "description": "Plan Parser for queot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "check": "pnpm \"/^check:.*/\"",
    "check:prettier": "prettier . --check",
    "check:eslint": "eslint",
    "fix": "pnpm \"/^fix:.+$/\"",
    "fix:prettier": "prettier . --write",
    "fix:eslint": "eslint --fix"
  },
  "dependencies": {
    "effect": "^3.19.14"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "typescript": "^5.9.3",
    "typescript-eslint": "catalog:",
    "vitest": "^4.0.16"
  }
}
