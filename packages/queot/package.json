{
  "name": "@sun-yryr/queot",
  "version": "0.1.1",
  "description": "Query Optimization Tool for SQL",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm -s dev:web & pnpm -s dev:api",
    "dev:web": "vite --open",
    "dev:api": "OCLIF_DEBUG=1 ./bin/dev.js serve -l 3000",
    "build:server": "node ./scripts/bundle-server.mjs",
    "build:client": "vite build",
    "build": "pnpm clean && pnpm build:server && pnpm build:client",
    "start": "NODE_ENV=production node ./bin/run.js serve",
    "clean": "rm -rf dist",
    "queot": "./bin/run.js",
    "queot:dev": "./bin/dev.js",
    "check": "pnpm \"/^check:.*/\"",
    "check:prettier": "prettier . --check",
    "check:eslint": "eslint",
    "check:types": "tsc --noEmit",
    "fix": "pnpm \"/^fix:.+$/\"",
    "fix:prettier": "prettier . --write",
    "fix:eslint": "eslint --fix",
    "test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@inquirer/prompts": "^8.1.0",
    "@oclif/core": "^4.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "daff": "^1.4.2",
    "effect": "^3.19.14",
    "hono": "^4.10.8",
    "open": "^11.0.0",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@sun-yryr/queot-planparser": "workspace:*",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.3",
    "@types/pg": "^8.16.0",
    "esbuild": "^0.27.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "oclif": "^4.22.55",
    "prettier": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "catalog:",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "files": [
    "dist",
    "bin/run.js",
    "bin/run.cmd",
    "../../README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "queot": "./bin/run.js"
  },
  "oclif": {
    "bin": "queot",
    "commands": "./dist/commands",
    "dirname": "queot",
    "helpOptions": {
      "flagSortOrder": "none"
    },
    "topicSeparator": " "
  }
}
