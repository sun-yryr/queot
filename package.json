{
  "name": "@sun-yryr/queot",
  "version": "0.0.0",
  "description": "Query Optimization Tool for SQL",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "pnpm \"/^check:.*/\"",
    "check:prettier": "prettier . --check",
    "check:eslint": "eslint",
    "fix": "pnpm \"/^fix:.+$/\"",
    "fix:prettier": "prettier . --write",
    "fix:eslint": "eslint --fix",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@oclif/core": "^4.8.0",
    "daff": "^1.4.2",
    "effect": "^3.19.12",
    "hono": "^4.10.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.3",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "oclif": "^4.22.55",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "bin": {
    "queot": "./bin/run.js"
  },
  "oclif": {
    "bin": "queot",
    "commands": "./dist/commands",
    "dirname": "queot",
    "topicSeparator": " "
  }
}
